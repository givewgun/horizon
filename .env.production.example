# ══════════════════════════════════════════════════════════════════════
# Horizon Production Environment Variables
# Copy to .env.production on the VM and fill in real values.
# Path on VM: /opt/horizon/app/.env.production
# ══════════════════════════════════════════════════════════════════════

# --- Runtime ---
NODE_ENV=production
PORT=8080

# --- Launches (Launch Library 2 / The Space Devs) ---
LL2_BASE=https://ll.thespacedevs.com/2.3.0

# --- Key-gated panels (panel disabled + FeedFallback shown if blank) ---
OPENWEATHER_KEY=
WINDY_KEY=
N2YO_KEY=

# --- Telegram bot (bot disabled at boot if either is missing) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Nominatim usage policy: descriptive User-Agent (required) ---
NOMINATIM_USER_AGENT=horizon/1.0 (contact: aongoong.jp@gmail.com)

# --- SQLite path inside container (persisted via ./data bind mount) ---
DB_PATH=/app/data/horizon.sqlite
