# --- Runtime ---
NODE_ENV=development
PORT=8080

# --- Launches (Launch Library 2 / The Space Devs) ---
# dev (no key, lower rate limits) for build/test:
LL2_BASE=https://lldev.thespacedevs.com/2.3.0
# prod (still keyless, higher quota):
# LL2_BASE=https://ll.thespacedevs.com/2.3.0

# --- Key-gated panels (panels disable + show FeedFallback if absent) ---
OPENWEATHER_KEY=
WINDY_KEY=
N2YO_KEY=

# --- Telegram bot (bot disabled at boot if either is missing) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Nominatim usage policy: descriptive User-Agent (required) ---
NOMINATIM_USER_AGENT=horizon/0.1 (contact: aongoong.jp@gmail.com)

# --- SQLite path inside container ---
DB_PATH=/app/data/horizon.sqlite
